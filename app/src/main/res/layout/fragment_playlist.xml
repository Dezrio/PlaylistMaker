<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fr_playlist"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/divider"
    tools:context=".ui.medialibrary.fragment.PlaylistFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/dimension_16" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/dimension_16" />

        <ProgressBar
            android:id="@+id/progress_bar_one_playlist"
            android:layout_width="@dimen/dimension_44"
            android:layout_height="@dimen/dimension_44"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dimension_140"
            android:indeterminateTint="@color/progress_bar"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_tags="iv_cover, tv_playlist_title, tv_playlist_sum_duration, tv_playlist_tracks_count" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_btns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_tags="iv_share, iv_menu" />

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/playlist_cover_description"
            app:layout_constraintDimensionRatio="w, 1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTag="iv_cover"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/player_placeholder" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_playlist"
            style="@style/ToolbarArrowBackStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_56"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIconTint="@color/color_main"
            app:title="" />

        <TextView
            android:id="@+id/tv_playlist_title"
            android:fontFamily="@font/ys_display_bold"
            android:textSize="24sp"
            android:textColor="@color/text_color_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_24"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@id/right_border"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/left_border"
            app:layout_constraintTag="tv_playlist_title"
            app:layout_constraintTop_toBottomOf="@id/iv_cover"
            tools:text="@string/playlist_title_test" />

        <TextView
            android:id="@+id/tv_playlist_description"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/color_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_8"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@id/right_border"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/left_border"
            app:layout_constraintTag="tv_playlist_description"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_title"
            tools:text="@string/playlist_title_test" />

        <TextView
            android:id="@+id/tv_playlist_sum_duration"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/color_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_8"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/left_border"
            app:layout_constraintTag="tv_playlist_sum_duration"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_description"
            app:layout_goneMarginTop="@dimen/dimension_8"
            tools:text="00 минут" />

        <TextView
            android:id="@+id/tv_playlist_tracks_count"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="18sp"
            android:textColor="@color/color_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_8"
            app:drawableStartCompat="@drawable/ic_text_limiter"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@id/right_border"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/tv_playlist_sum_duration"
            app:layout_constraintTag="tv_playlist_tracks_count"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_description"
            app:layout_goneMarginTop="@dimen/dimension_8"
            tools:text="99 треков" />

        <ImageView
            android:id="@+id/iv_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_16"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:src="@drawable/share"
            app:layout_constraintStart_toStartOf="@id/left_border"
            app:layout_constraintTag="iv_share"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_sum_duration"
            app:tint="@color/color_main" />

        <ImageView
            android:id="@+id/iv_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimension_16"
            android:layout_marginTop="@dimen/dimension_16"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:src="@drawable/menu"
            app:layout_constraintStart_toEndOf="@id/iv_share"
            app:layout_constraintTag="iv_menu"
            app:layout_constraintTop_toBottomOf="@id/tv_playlist_sum_duration"
            app:tint="@color/color_main" />

        <View
            android:id="@+id/v_bottom_sheet_tracks_coordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_24"
            android:background="@null"
            app:layout_constraintStart_toStartOf="@id/left_border"
            app:layout_constraintTop_toBottomOf="@id/iv_share" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottom_sheet_tracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="150dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="@dimen/dimension_50"
            android:layout_height="@dimen/dimension_4"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dimension_8"
            android:background="@drawable/bottom_sheet_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_empty_track_list"
            android:fontFamily="@font/ys_display_medium"
            android:textSize="@dimen/dimension_19"
            android:textColor="?attr/colorOnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_24"
            android:layout_marginTop="@dimen/dimension_16"
            android:text="@string/empty_playlist_track_list_message"
            android:textAlignment="center" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimension_12"
            tools:listitem="@layout/track_item" />


    </LinearLayout>

    <View
        android:id="@+id/v_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottom_sheet_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="400dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="@dimen/dimension_50"
            android:layout_height="@dimen/dimension_4"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dimension_8"
            android:background="@drawable/bottom_sheet_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_playlist_mini"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimension_60"
            android:layout_marginHorizontal="@dimen/dimension_13"
            android:layout_marginTop="@dimen/dimension_12">

            <ImageView
                android:id="@+id/iv_playlist_cover_mini"
                android:layout_width="@dimen/dimension_45"
                android:layout_height="@dimen/dimension_45"
                android:contentDescription="@string/playlist_cover_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/player_placeholder" />

            <TextView
                android:id="@+id/tv_playlist_title_mini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimension_8"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/tv_playlist_tracks_count_mini"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/iv_playlist_cover_mini"
                app:layout_constraintTop_toTopOf="@id/iv_playlist_cover_mini"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="@string/playlist_title_test" />

            <TextView
                android:id="@+id/tv_playlist_tracks_count_mini"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="@dimen/dimension_11"
                android:textColor="?attr/colorOnSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimension_8"
                android:layout_marginTop="@dimen/dimension_1"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="@id/iv_playlist_cover_mini"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/iv_playlist_cover_mini"
                app:layout_constraintTop_toBottomOf="@id/tv_playlist_title_mini"
                tools:text="@string/playlist_tracks_count_test" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_share_playlist"
            style="@style/RegularText16ColorStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_16"
            android:layout_marginTop="@dimen/dimension_28"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:text="@string/share_playlist" />

        <TextView
            android:id="@+id/tv_edit_playlist"
            style="@style/RegularText16ColorStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_16"
            android:layout_marginTop="@dimen/dimension_42"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:text="@string/edit_playlist" />

        <TextView
            android:id="@+id/tv_delete_playlist"
            style="@style/RegularText16ColorStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimension_16"
            android:layout_marginTop="@dimen/dimension_42"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:text="@string/delete_playlist" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>